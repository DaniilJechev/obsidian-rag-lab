# Runtime environment
APP_ENV=development
LOG_LEVEL=INFO

# Read-only Obsidian vault root.
# The application may read only the DLS1 and DLS2 subdirectories.
OBSIDIAN_VAULT_ROOT=C:/Users/your-user/obsidianNotes

# LLM provider. Keep the real key only in a local .env file.
OPENROUTER_API_KEY=

# Local PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=rag
POSTGRES_USER=rag
POSTGRES_PASSWORD=

# Local Qdrant
QDRANT_URL=http://localhost:6333
