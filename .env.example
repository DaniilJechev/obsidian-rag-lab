# Runtime environment
APP_ENV=development
LOG_LEVEL=INFO

# Read-only Obsidian vault root.
# The configuration loader reads this value; discovery may read only the DLS1
# and DLS2 subdirectories.
OBSIDIAN_VAULT_ROOT=C:/Users/your-user/obsidianNotes
# Comma-separated allowlist passed to the read-only discovery layer.
ALLOWED_CORPUS_DIRECTORIES=DLS1,DLS2

# Sprint 9 experiment runtime
# Python clients send runs to this MLflow Tracking Server.
MLFLOW_TRACKING_URI=http://127.0.0.1:5000
# The MLflow server stores run metadata in SQLite.
MLFLOW_BACKEND_STORE_URI=sqlite:///mlflow.db
# The MLflow server stores uploaded artifacts here.
MLFLOW_ARTIFACT_ROOT=artifacts/mlflow
# Local reproducible reports before they are uploaded to MLflow.
EXPERIMENT_ARTIFACT_DIR=artifacts/chunking
EXPERIMENT_NAME=sprint-9-chunking-experiments
EXPERIMENT_PROTOCOL_PATH=configs/experiments/sprint9_chunking.yaml

# Sprint 10 local embedding smoke experiment
EMBEDDING_MODEL_CONFIG_PATH=configs/embeddings/multilingual_e5_small.yaml
EMBEDDING_EXPERIMENT_NAME=sprint-10-embedding-smoke

# Sprint 11 batch embedding pipeline
BATCH_EMBEDDING_CONFIG_PATH=configs/embeddings/sprint11_batch.yaml

# LLM provider. Add the real key only to a local .env file when Phase 9 starts.
OPENROUTER_API_KEY=

# Local PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=rag
POSTGRES_USER=rag
# Replace this placeholder only in the local .env file.
POSTGRES_PASSWORD=

# Local Qdrant
QDRANT_URL=http://localhost:6333
